# KaushalPath PRODUCTION environment template (Phase 9).
# Copy to `.env` at the repo root (docker-compose reads `env_file: .env`), then
# fill in real values. `.env` is git-ignored; NEVER commit it.
#
# These settings satisfy the app's prod fail-fast guards (see
# backend/app/core/config.py::_prod_hardening): the container will REFUSE to
# boot in APP_ENV=prod with a default secret, a wildcard CORS origin, or debug
# enabled. That is deliberate — it is impossible to "accidentally ship" those.

# --- App ---
APP_NAME=KaushalPath
APP_ENV=prod
DEBUG=false
LOG_LEVEL=INFO

# --- Security (REQUIRED overrides; the app won't start prod with defaults) ---
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true
# Keep the API reference private in prod; flip to true only while debugging.
API_DOCS_ENABLED=false

# --- Database ---
# Single-node demo: SQLite on the /data volume (matches docker-compose.prod.yml).
# To move to PostgreSQL: add a driver to backend/requirements.txt (e.g.
# psycopg[binary]) and point DATABASE_URL at it — no application code changes.
DATABASE_URL=sqlite:////data/kaushalpath.db

# --- CORS: concrete public origin(s), comma-separated. No '*' in prod. ---
# For the single-origin Nginx stack this can stay the browser-facing URL.
CORS_ORIGINS=https://your-domain.example

# --- Model metadata ---
MODEL_VERSION=kaushalpath-rank-1.0.0
