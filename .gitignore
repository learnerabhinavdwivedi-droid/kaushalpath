# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3
*.db
*.db-journal

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# --- Env / secrets (RULES: never commit) ---
.env
.env.*
!.env.example

# --- ML / data artifacts ---
# HF / sentence-transformers runtime cache (large, licence-bound; re-downloadable)
.cache/
backend/app/.cache/
# generated seed / trained artefacts (regenerated by seed_all.py + train.py)
backend/app/data/processed/*
!backend/app/data/processed/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
# large / licence-bound raw downloads: track only the manifest README and SOURCES.yaml
backend/app/data/raw/**
!backend/app/data/raw/README.md
!backend/app/data/raw/SOURCES.yaml
*.faiss
*.bin
*.joblib
models/*.txt
ranker_model.txt
ranker_meta.json
occupation_mapping.json

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Logs / tmp ---
*.log
tmp/

# --- DB backups (scripts/backup_db.py output) ---
backups/
