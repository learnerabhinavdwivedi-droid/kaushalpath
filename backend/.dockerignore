# Keep the backend build context small and reproducible. Crucially this stops
# a host (often Windows) .venv / local SQLite from being baked into the Linux
# image, which `COPY . ./` would otherwise do.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# local databases (the container uses the /data volume, never a baked-in db)
*.db
*.sqlite3
# runtime data artefacts are regenerated by migrations + the seed job
data/processed/
app/data/raw/
app/data/processed/
# tests are not part of the prod runtime image
tests/
*.log
