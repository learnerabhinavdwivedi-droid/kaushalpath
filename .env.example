# Copy to .env and fill real values. NEVER commit .env (see .gitignore).
# Every variable used by the app must be documented here (RULES: no hard-coded secrets).

# --- App ---
APP_NAME=KaushalPath
APP_ENV=dev                 # dev | test | prod
DEBUG=true
LOG_LEVEL=INFO

# --- Security (prod MUST override; generate: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (SQLite dev / PostgreSQL prod) ---
DATABASE_URL=sqlite:///./kaushalpath.db

# --- CORS: comma-separated allowed origins ---
CORS_ORIGINS=http://localhost:5173

# --- Model metadata ---
MODEL_VERSION=0.0.0-untrained
