# Copy to .env and fill real values. NEVER commit .env (see .gitignore).
# Every variable used by the app must be documented here (RULES: no hard-coded secrets).

# --- App ---
APP_NAME=KaushalPath
APP_ENV=dev                 # dev | test | prod
DEBUG=true
LOG_LEVEL=INFO

# --- Security (prod MUST override; generate: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (SQLite dev / PostgreSQL prod) ---
DATABASE_URL=sqlite:///./kaushalpath.db

# --- CORS: comma-separated allowed origins ---
CORS_ORIGINS=http://localhost:5173

# --- Model metadata ---
MODEL_VERSION=0.0.0-untrained

# --- Human escalation (Phase 14) ---
# Resistance score at/above which a conversation is auto-escalated to a human.
ESCALATION_RS_THRESHOLD=0.6
# Hand-off notifier adapter: console | sms_stub | whatsapp (console = offline default).
NOTIFIER_PROVIDER=console

# --- LLM Provider & Conversational Paraphrasing (Phase 27) ---
# Default is "none": runs 100% offline, deterministic, zero hallucination risk (recommended for live demo/stage).
# Optional richer phrasing: toggle to "openai_compat" or "gemini".
# Caveat: External API is NEVER required; on any timeout or error in responder.py:_call_llm_api
# or ungrounded number in validator.py, it falls back silently to the template path — the family-facing reply is never blocked.
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

